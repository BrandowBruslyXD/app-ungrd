# Variables del despliegue en servidor. Copia a deploy/.env.server y rellena.
# (deploy/.env.server está en .gitignore — NUNCA se sube al repo.)

# ── Postgres (nuestro, aislado) ──
POSTGRES_USER=wabots
POSTGRES_PASSWORD=CAMBIA_ESTO
POSTGRES_DB=wabots

# ── Backend ──
DATABASE_URL=postgresql://wabots:CAMBIA_ESTO@wabots-postgres:5432/wabots?schema=public
PORT=3000
NODE_ENV=production
FRONTEND_URL=http://localhost:8090

JWT_SECRET=CAMBIA_ESTO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CAMBIA_ESTO_OTRO_DISTINTO
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=CAMBIA_ESTO_64_HEX

ADMIN_USERNAME=ldikay99
ADMIN_EMAIL=solopvppro@gmail.com
ADMIN_PASSWORD=give@p1371
ADMIN_NAME=ldikay99

# ── Evolution API (DNS interno en la red 'edge') ──
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=CAMBIA_ESTO
# Webhook interno: Evolution alcanza nuestro backend por nombre de contenedor.
PUBLIC_BACKEND_URL=http://wabots-backend:3000

# ── Google OAuth2 (Calendar / Gmail) ──
# Credenciales del cliente OAuth creado en Google Cloud Console.
GOOGLE_CLIENT_ID=CAMBIA_ESTO_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CAMBIA_ESTO_GOOGLE_CLIENT_SECRET
# Debe coincidir EXACTAMENTE con la URI autorizada en Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8090/api/integrations/google/callback
