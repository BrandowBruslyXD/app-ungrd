{
  "info": {
    "name": "ConectaRiesgoAI — API",
    "description": "Colección de pruebas del backend .NET.\n\n**Ejecutar con el Runner en orden**: las carpetas están numeradas y encadenadas — el registro guarda el token, el reporte guarda el código, y el resto los reutiliza.\n\nVariables necesarias: `baseUrl` y `claveServicio`.\n\nLa carpeta *90 · Seguridad* comprueba que los endpoints protegidos rechazan a quien no debe entrar. Si alguna de esas pruebas pasa a 200, hay un agujero.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "description": "Sin barra final"
    },
    {
      "key": "claveServicio",
      "value": "",
      "description": "X-Api-Key de ingesta. NO se versiona."
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenGestor",
      "value": ""
    },
    {
      "key": "codigoReporte",
      "value": ""
    },
    {
      "key": "emailCiudadano",
      "value": ""
    },
    {
      "key": "telefonoBot",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 · Salud",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Lo primero que se ejecuta: si esto falla, no sigas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"responde en menos de 3 s\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "pm.test(\"el servicio se identifica\", () => pm.expect(pm.response.json()).to.have.property(\"servicio\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "10 · Autenticación",
      "item": [
        {
          "name": "Registro de ciudadano",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "Crea el ciudadano y guarda su token para el resto de la corrida.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"María Rodríguez\",\n  \"email\": \"maria+{{sufijo}}@ejemplo.test\",\n  \"password\": \"unaClaveSegura123\",\n  \"municipio\": \"Soacha\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 201\", () => pm.response.to.have.status(201));",
                  "const d = pm.response.json();",
                  "pm.test(\"devuelve token y usuario\", () => { pm.expect(d).to.have.property(\"token\"); pm.expect(d.usuario).to.have.property(\"id\"); });",
                  "pm.test(\"el rol por defecto es Ciudadano\", () => pm.expect(d.usuario.rol).to.eql(\"Ciudadano\"));",
                  "pm.test(\"NUNCA devuelve la contraseña\", () => pm.expect(pm.response.text()).to.not.match(/password|hash/i));",
                  "pm.environment.set(\"token\", d.token);",
                  "pm.environment.set(\"emailCiudadano\", d.usuario.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailCiudadano}}\",\n  \"password\": \"unaClaveSegura123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.environment.set(\"token\", pm.response.json().token);",
                  "pm.test(\"devuelve token\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con contraseña incorrecta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "El mensaje no debe revelar si el correo está registrado: eso permite enumerar usuarios.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailCiudadano}}\",\n  \"password\": \"estaNoEs\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"rechaza con 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"no dice si el correo existe\", () => pm.expect(pm.response.text()).to.not.match(/no existe|not found|usuario no/i));",
                  "pm.test(\"el error no filtra detalles internos\", () => {\n  const t = pm.response.text();\n  [\"StackTrace\",\"at ConectaRiesgoAI\",\"Npgsql\",\"System.\",\"Exception:\"].forEach(p =>\n    pm.expect(t, `filtra \"${p}\"`).to.not.include(p));\n});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi perfil",
